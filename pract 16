using System;

// Задание 1: 
class Point
{
    public int X, Y;
    public Point(int x, int y) { X = x; Y = y; }
    
    public static Point operator +(Point a, Point b) => new Point(a.X + b.X, a.Y + b.Y);
    public static Point operator -(Point a, Point b) => new Point(a.X - b.X, a.Y - b.Y);
    
    public override string ToString() => $"({X}, {Y})";
}

// Задание 2: 
class Counter
{
    public string Name;
    public int Value;
    public Counter(string name, int value) { Name = name; Value = value; }
    
    public static Counter operator +(Counter c, int n) => new Counter(c.Name, c.Value + n);
    
    public int this[string key]
    {
        get => key == "value" ? Value : -1;
        set { if (key == "value") Value = value; }
    }
    
    public override string ToString() => $"{Name}: {Value}";
}

// Задание 3: 
class Temperature
{
    public double Celsius;
    public Temperature(double celsius) { Celsius = celsius; }
    
    public static bool operator >(Temperature t1, Temperature t2) => t1.Celsius > t2.Celsius;
    public static bool operator <(Temperature t1, Temperature t2) => t1.Celsius < t2.Celsius;
    public static bool operator ==(Temperature t1, Temperature t2) => t1.Celsius == t2.Celsius;
    public static bool operator !=(Temperature t1, Temperature t2) => t1.Celsius != t2.Celsius;
    
    public override string ToString() => $"{Celsius}°C";
    public override bool Equals(object obj) => obj is Temperature t && this == t;
    public override int GetHashCode() => Celsius.GetHashCode();
}

// Задание 4: 
class Book
{
    private string[] chapters = new string[10];
    
    public string this[int index]
    {
        get => chapters[index];
        set => chapters[index] = value;
    }
    
    public override string ToString()
    {
        string result = "";
        for (int i = 0; i < chapters.Length; i++)
            if (chapters[i] != null)
                result += $"{i + 1}. {chapters[i]}\n";
        return result.Trim();
    }
}

// Задание 5: 
class Vector
{
    private double[] coords;
    public Vector(params double[] values) => coords = values;
    
    public static double operator *(Vector v1, Vector v2)
    {
        double sum = 0;
        for (int i = 0; i < v1.coords.Length; i++)
            sum += v1.coords[i] * v2.coords[i];
        return sum;
    }
    
    public double this[int index]
    {
        get => coords[index];
        set => coords[index] = value;
    }
    
    public override string ToString() => $"[{string.Join(", ", coords)}]";
}

class Program
{
